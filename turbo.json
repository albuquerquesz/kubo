{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "RESEND_API_KEY",
    "EMAIL_FROM",
    "NEXT_PUBLIC_CONVEX_URL",
    "NEXT_PUBLIC_CONVEX_SITE_URL",
    "NEXT_PUBLIC_HIMETRICA_API_KEY",
    "SKIP_ENV_VALIDATION"
  ],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "templates-binary/**"],
      "env": [
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "NEXT_PUBLIC_CONVEX_URL",
        "NEXT_PUBLIC_CONVEX_SITE_URL",
        "NEXT_PUBLIC_HIMETRICA_API_KEY",
        "SKIP_ENV_VALIDATION"
      ]
    },
    "bundle": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["build/**", "out/**"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "check": {
      "dependsOn": ["transit"]
    },
    "generate-schema": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:remote": {
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "cache": false
    },
    "deploy:convex": {
      "cache": false
    }
  }
}
