{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "templates-binary/**"],
      "env": ["NOTIFIQUE_API_KEY", "NOTIFIQUE_FROM_EMAIL", "NOTIFIQUE_NEWSLETTER_LIST_ID"]
    },
    "bundle": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["build/**", "out/**"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "check": {
      "dependsOn": ["transit"]
    },
    "generate-schema": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:remote": {
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "cache": false
    },
    "deploy:convex": {
      "cache": false
    }
  }
}
