{
	"extends": "./tsconfig.base.json",
	"include": ["src", "e2e", "vite.config.ts", "playwright.config.ts"],
	"compilerOptions": {
		"jsx": "react-jsx",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],
		"allowImportingTsExtensions": true,
		"noUncheckedSideEffectImports": true,
		"paths": { "#/*": ["./src/*"] }
	}
}
